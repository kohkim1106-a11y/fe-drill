{
  "name": "fe-drill",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "基本情報技術者試験の学習PWA（基本情報ドリル）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:data": "vitest run tests/data",
    "build:ios": "VITE_TARGET=ios npm run build && cap sync ios",
    "ios": "npm run build:ios && cap open ios"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans-jp": "5.3.1",
    "@preact/signals": "2.11.3",
    "firebase": "13.1.0",
    "preact": "10.29.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3",
    "@preact/preset-vite": "2.10.6",
    "@testing-library/preact": "3.2.6",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  }
}
